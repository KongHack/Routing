{
    "name": "gcworld/routing",
    "description": "GCWorld Industries Routing",
    "authors": [
        {
            "name": "GameCharmer",
            "email": "admin@gamecharmer.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-redis": "*",
        "gcworld/interfaces": "^4.4",
        "gcworld/utilities": "^2.0",
        "phpdocumentor/reflection-docblock": "^5.3"
    },
    "require-dev": {
        "gcworld/database": "^2.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "suggest": {
        "ext-redis": "Redis Caching",
        "gcworld/database": "the actual database class we are using for logging"
    },
    "autoload": {
        "psr-4": {
            "GCWorld\\Routing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GCWorld\\Routing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit",
        "check": [
            "@lint",
            "@phpstan",
            "@phpcs",
            "@test"
        ]
    },
    "license": "MIT",
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
